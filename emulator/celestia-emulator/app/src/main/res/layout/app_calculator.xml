<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1A"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/calc_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#00D4FF"
            android:textSize="20sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Calculator"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Display -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/calc_display_bg"
        android:padding="24dp"
        android:layout_marginTop="8dp"
        android:gravity="end">

        <TextView
            android:id="@+id/calc_display"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#00D4FF"
            android:textSize="40sp" />
    </LinearLayout>

    <!-- Buttons -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:columnCount="4"
        android:rowCount="5"
        android:layout_marginTop="16dp"
        android:useDefaultMargins="true">

        <TextView android:id="@+id/calc_c" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="C" android:textColor="#FF4444" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_open" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="(" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_close" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text=")" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_percent" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="%" android:textColor="#00D4FF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />

        <TextView android:id="@+id/calc_7" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="7" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_8" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="8" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_9" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="9" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_div" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="÷" android:textColor="#00D4FF" android:textSize="22sp" android:background="@drawable/calc_btn_active" android:layout_margin="4dp" />

        <TextView android:id="@+id/calc_4" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="4" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_5" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="5" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_6" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="6" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_mul" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="×" android:textColor="#00D4FF" android:textSize="22sp" android:background="@drawable/calc_btn_active" android:layout_margin="4dp" />

        <TextView android:id="@+id/calc_1" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="1" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_2" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="2" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_3" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="3" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_sub" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="-" android:textColor="#00D4FF" android:textSize="22sp" android:background="@drawable/calc_btn_active" android:layout_margin="4dp" />

        <TextView android:id="@+id/calc_0" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="0" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_dot" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="." android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_backspace" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="⌫" android:textColor="#FFFFFF" android:textSize="22sp" android:background="@drawable/calc_btn" android:layout_margin="4dp" />
        <TextView android:id="@+id/calc_equals" android:layout_width="0dp" android:layout_height="0dp" android:layout_columnWeight="1" android:layout_rowWeight="1" android:gravity="center" android:text="=" android:textColor="#0A0A1A" android:textSize="22sp" android:textStyle="bold" android:background="@drawable/calc_equals_btn" android:layout_margin="4dp" />
    </GridLayout>
</LinearLayout>
