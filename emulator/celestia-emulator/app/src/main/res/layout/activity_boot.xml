<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A1A">

    <!-- Nebula Background -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/nebula_bg" />

    <!-- Center Content -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center">

        <!-- Logo -->
        <ImageView
            android:id="@+id/boot_logo"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:src="@drawable/boot_logo"
            android:alpha="0" />

        <!-- Star Glow -->
        <View
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginTop="-60dp"
            android:background="@drawable/star_glow" />

        <!-- Text -->
        <TextView
            android:id="@+id/boot_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CELESTIA"
            android:textColor="#00D4FF"
            android:textSize="32sp"
            android:letterSpacing="0.3"
            android:layout_marginTop="32dp"
            android:alpha="0" />

        <TextView
            android:id="@+id/boot_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1.0 Nebula"
            android:textColor="#66FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:alpha="0" />

        <!-- Progress -->
        <ProgressBar
            android:id="@+id/boot_progress"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="200dp"
            android:layout_height="3dp"
            android:layout_marginTop="48dp"
            android:max="100"
            android:progress="0"
            android:progressDrawable="@drawable/boot_progress" />

    </LinearLayout>

</FrameLayout>
