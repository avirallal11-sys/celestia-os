<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0A0A1A"
    android:padding="16dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/github_back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#00D4FF"
            android:textSize="20sp"
            android:padding="8dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="GitHub Sync"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔄"
            android:textSize="64sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Celestia OS Sync"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pull latest updates from GitHub"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:layout_marginTop="8dp" />

        <!-- Repo URL -->
        <EditText
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/search_bg"
            android:text="https://github.com/celestia-os/celestia-os"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:paddingHorizontal="16dp"
            android:layout_marginTop="24dp"
            android:singleLine="true"
            android:importantForAutofill="no" />

        <!-- Sync Button -->
        <TextView
            android:id="@+id/github_sync"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center"
            android:text="Pull and Update"
            android:textColor="#0A0A1A"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/sync_btn"
            android:layout_marginTop="16dp" />

        <!-- Status -->
        <TextView
            android:id="@+id/github_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ready to sync"
            android:textColor="#B3FFFFFF"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</LinearLayout>
