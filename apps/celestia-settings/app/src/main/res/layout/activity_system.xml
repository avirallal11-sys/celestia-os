<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SettingsHeader"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:contentDescription="Back"/>
        <TextView style="@style/HeaderTitle"
            android:text="@string/system_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Languages & Input -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_system"
                    android:contentDescription="Language"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_language"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="English (United States)"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Date & Time -->
            <LinearLayout
                android:id="@+id/datetimeItem"
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_system"
                    android:contentDescription="Date"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_datetime"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <!-- Auto date/time toggle -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="horizontal"
                android:paddingLeft="56dp">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_datetime_auto"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/autoTimeSwitch"
                    style="@style/SwitchStyle"
                    android:checked="true"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Timezone -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal"
                android:paddingLeft="56dp">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/timezone"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="UTC-05:00 Eastern Time"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Backup & Reset -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_system"
                    android:contentDescription="Backup"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_backup"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Reset Options -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_system"
                    android:contentDescription="Reset"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_reset"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- System Updates -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_info"
                    android:contentDescription="Update"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_updates"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Your system is up to date"/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Gesture Navigation -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_system"
                    android:contentDescription="Gesture"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_gestures"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Gesture navigation"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- One-handed Mode -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_one_hand"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/oneHandSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Developer Options Link -->
            <LinearLayout
                android:id="@+id/developerLink"
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_dev"
                    android:contentDescription="Dev"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/system_developer"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
