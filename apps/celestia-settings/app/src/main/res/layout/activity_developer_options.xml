<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SettingsHeader"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:contentDescription="Back"/>
        <TextView style="@style/HeaderTitle"
            android:text="@string/cat_developer"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <TextView
                style="@style/SectionHeader"
                android:text="Debugging"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="USB debugging"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Debug mode when USB is connected"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/usbDebuggingSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="OEM unlocking"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Allow OEM unlocking"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/oemUnlockSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <TextView
                style="@style/SectionHeader"
                android:text="Input"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="Show touches"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/showTouchesSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="Pointer location"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/pointerLocationSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <TextView
                style="@style/SectionHeader"
                android:text="Drawing"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="Stay awake"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Keep screen on while charging"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/stayAwakeSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <TextView
                style="@style/SectionHeader"
                android:text="Networking"/>

            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="Wi-Fi scan throttling"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="Reduce battery usage"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/wifiThrottlingSwitch"
                    style="@style/SwitchStyle"
                    android:checked="true"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
