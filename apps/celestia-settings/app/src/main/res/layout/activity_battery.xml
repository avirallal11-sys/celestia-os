<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SettingsHeader"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:contentDescription="Back"/>
        <TextView style="@style/HeaderTitle"
            android:text="@string/battery_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingBottom="16dp">

            <!-- Battery Visual -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:paddingTop="24dp"
                android:paddingBottom="16dp">

                <!-- Battery Icon -->
                <FrameLayout
                    android:layout_width="80dp"
                    android:layout_height="140dp"
                    android:layout_marginBottom="16dp">
                    <View
                        android:layout_width="60dp"
                        android:layout_height="120dp"
                        android:layout_gravity="center"
                        android:background="@color/surface"/>
                    <View
                        android:id="@+id/batteryFill"
                        android:layout_width="54dp"
                        android:layout_height="0dp"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_margin="3dp"
                        android:background="@color/safe_green"/>
                    <View
                        android:layout_width="20dp"
                        android:layout_height="8dp"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="0dp"
                        android:background="@color/surface"/>
                </FrameLayout>

                <TextView
                    android:id="@+id/batteryPercent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="87%"
                    android:textColor="@color/text_primary"
                    android:textSize="48sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/battery_estimated"
                    android:textColor="@color/text_secondary"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"/>
            </LinearLayout>

            <!-- Usage Graph -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingLeft="16dp"
                android:paddingRight="16dp"
                android:layout_marginBottom="16dp">
                <TextView
                    style="@style/SectionHeader"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:text="@string/battery_usage"/>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="100dp"
                    android:orientation="horizontal"
                    android:gravity="bottom"
                    android:paddingTop="8dp">
                    <View android:layout_width="0dp" android:layout_height="60dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.7"/>
                    <View android:layout_width="0dp" android:layout_height="45dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.5"/>
                    <View android:layout_width="0dp" android:layout_height="80dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.9"/>
                    <View android:layout_width="0dp" android:layout_height="35dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.4"/>
                    <View android:layout_width="0dp" android:layout_height="55dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.6"/>
                    <View android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.45"/>
                    <View android:layout_width="0dp" android:layout_height="70dp" android:layout_weight="1" android:layout_margin="2dp" android:background="@color/accent" android:alpha="0.8"/>
                </LinearLayout>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Power Saving -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/battery_saving"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/powerSavingSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Adaptive Battery -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/battery_adaptive"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/adaptiveBatterySwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Battery Info -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    style="@style/SectionHeader"
                    android:paddingLeft="0dp"
                    android:paddingTop="0dp"
                    android:text="Battery Information"/>

                <LinearLayout
                    style="@style/SettingsItemCompact"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/ItemTitle"
                        android:text="@string/battery_last_charge"/>
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingsItemCompact"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/ItemTitle"
                        android:text="Temperature: 31°C"/>
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingsItemCompact"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/ItemTitle"
                        android:text="Voltage: 4.2V"/>
                </LinearLayout>

                <LinearLayout
                    style="@style/SettingsItemCompact"
                    android:orientation="horizontal">
                    <TextView
                        style="@style/ItemTitle"
                        android:text="Technology: Li-ion"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
