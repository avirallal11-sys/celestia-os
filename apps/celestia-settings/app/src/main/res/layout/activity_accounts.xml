<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SettingsHeader"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:contentDescription="Back"/>
        <TextView style="@style/HeaderTitle"
            android:text="@string/accounts_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Auto-sync -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/accounts_auto_sync"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/autoSyncSwitch"
                    style="@style/SwitchStyle"
                    android:checked="true"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <TextView
                style="@style/SectionHeader"
                android:text="Accounts"/>

            <!-- Google -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_accounts"
                    android:contentDescription="Google"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="Google"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="aviral@gmail.com"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- GitHub -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    style="@style/ItemIcon"
                    android:src="@drawable/ic_accounts"
                    android:contentDescription="GitHub"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="GitHub"/>
                    <TextView style="@style/ItemSubtitle"
                        android:text="avirallal11-sys"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Add Account -->
            <LinearLayout
                android:id="@+id/addAccountItem"
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_input_add"
                    android:layout_marginRight="16dp"
                    android:contentDescription="Add"/>
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/accounts_add"
                        android:textColor="@color/accent"/>
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
