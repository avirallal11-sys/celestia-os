<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <LinearLayout
        style="@style/SettingsHeader"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/btnBack"
            style="@style/BackButton"
            android:src="@drawable/ic_chevron"
            android:rotation="180"
            android:contentDescription="Back"/>
        <TextView style="@style/HeaderTitle"
            android:text="@string/sound_title"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Media Volume -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_media"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <SeekBar
                    android:id="@+id/mediaVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="70"
                    android:progressDrawable="@drawable/brightness_slider"
                    android:thumbTint="@color/accent"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Ringtone Volume -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_ringtone"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <SeekBar
                    android:id="@+id/ringtoneVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"
                    android:progressDrawable="@drawable/brightness_slider"
                    android:thumbTint="@color/accent"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Notification Volume -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_notifications"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <SeekBar
                    android:id="@+id/notificationVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="60"
                    android:progressDrawable="@drawable/brightness_slider"
                    android:thumbTint="@color/accent"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Alarm Volume -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_alarm"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <SeekBar
                    android:id="@+id/alarmVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="90"
                    android:progressDrawable="@drawable/brightness_slider"
                    android:thumbTint="@color/accent"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- System Volume -->
            <LinearLayout
                style="@style/SettingsItemCompact"
                android:orientation="vertical"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/volume_system"
                    android:textColor="@color/text_primary"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>
                <SeekBar
                    android:id="@+id/systemVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="50"
                    android:progressDrawable="@drawable/brightness_slider"
                    android:thumbTint="@color/accent"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Do Not Disturb -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/sound_dnd"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/dndSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Ringtone -->
            <LinearLayout
                android:id="@+id/ringtoneItem"
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/sound_ringtone"/>
                    <TextView
                        android:id="@+id/ringtoneName"
                        style="@style/ItemSubtitle"
                        android:text="Andromeda"/>
                </LinearLayout>
                <ImageView style="@style/Chevron"
                    android:src="@drawable/ic_chevron"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Vibration -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/sound_vibrate"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/vibrationSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

            <View style="@style/DividerStyle"/>

            <!-- Touch Sounds -->
            <LinearLayout
                style="@style/SettingsItem"
                android:orientation="horizontal">
                <LinearLayout
                    style="@style/ItemTitleVertical"
                    android:orientation="vertical">
                    <TextView style="@style/ItemTitle"
                        android:text="@string/sound_touch"/>
                </LinearLayout>
                <Switch
                    android:id="@+id/touchSoundSwitch"
                    style="@style/SwitchStyle"
                    android:thumbTint="@color/accent"
                    android:trackTint="@color/switch_track_off"/>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
