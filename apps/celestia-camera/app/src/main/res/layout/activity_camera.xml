<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0A0A1A">

    <!-- Camera Preview -->
    <TextureView
        android:id="@+id/texture_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Grid Overlay -->
    <View
        android:id="@+id/grid_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="@android:color/transparent" />

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="#80000020">

        <!-- Gallery Thumbnail -->
        <ImageView
            android:id="@+id/btn_gallery"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:scaleType="centerCrop"
            android:background="#40000000"
            android:contentDescription="Gallery"
            android:padding="4dp" />

        <TextView
            android:id="@+id/txt_timer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text=""
            android:textColor="#FF00D4FF"
            android:textSize="16sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/txt_mode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="PHOTO"
            android:textColor="#FF00D4FF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:letterSpacing="0.2" />

        <!-- Grid Toggle -->
        <ImageButton
            android:id="@+id/btn_grid"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_grid"
            android:background="@drawable/btn_circle"
            android:scaleType="centerInside"
            android:layout_marginStart="8dp"
            android:contentDescription="Grid" />
    </LinearLayout>

    <!-- Timer Countdown Overlay -->
    <TextView
        android:id="@+id/txt_countdown"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text=""
        android:textColor="#FFFFFFFF"
        android:textSize="96sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Zoom Controls -->
    <LinearLayout
        android:id="@+id/zoom_controls"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_above="@id/bottom_controls"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#60000000"
        android:paddingHorizontal="8dp">

        <TextView
            android:id="@+id/zoom_1x"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="1x"
            android:textColor="#FFFFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:background="@drawable/btn_circle" />

        <TextView
            android:id="@+id/zoom_2x"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="2x"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginStart="8dp" />

        <TextView
            android:id="@+id/zoom_5x"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:text="5x"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:gravity="center"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Bottom Controls -->
    <LinearLayout
        android:id="@+id/bottom_controls"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="16dp"
        android:background="#80000020">

        <!-- Flash Button -->
        <ImageButton
            android:id="@+id/btn_flash"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_flash_off"
            android:background="@drawable/btn_circle"
            android:scaleType="centerInside"
            android:contentDescription="Flash" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Capture Button -->
        <ImageButton
            android:id="@+id/btn_capture"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/btn_capture"
            android:background="@drawable/btn_capture_bg"
            android:scaleType="centerInside"
            android:contentDescription="Capture" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Mode Switch Button (Timer) -->
        <ImageButton
            android:id="@+id/btn_timer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_timer"
            android:background="@drawable/btn_circle"
            android:scaleType="centerInside"
            android:contentDescription="Timer" />

    </LinearLayout>

    <!-- Switch Camera Button (top right) -->
    <ImageButton
        android:id="@+id/btn_switch"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_margin="16dp"
        android:src="@drawable/ic_switch_camera"
        android:background="@drawable/btn_circle"
        android:scaleType="centerInside"
        android:contentDescription="Switch Camera" />

    <!-- Recording Timer -->
    <TextView
        android:id="@+id/txt_recording_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginTop="60dp"
        android:layout_centerHorizontal="true"
        android:text=""
        android:textColor="#FFFF0000"
        android:textSize="18sp"
        android:fontFamily="monospace"
        android:visibility="gone" />

</RelativeLayout>
